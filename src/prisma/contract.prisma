// use prisma-8

model User {
  id        String   @id @onCreate(uuid())
  phone     String   @unique
  createdAt DateTime @default(now())

  loans Loan[]
}

model Loan {
  id         String     @id @onCreate(uuid())
  userId     String
  friendName String
  amount     Float
  dueDate    DateTime
  status     LoanStatus @default(PENDING)
  repaidAt   DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([dueDate])
}

model OtpCode {
  id        String   @id @onCreate(uuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

enum LoanStatus {
  PENDING
  REPAID
}